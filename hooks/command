#!/bin/bash

set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
  echo "ERROR: Node.js is required but was not found in PATH." >&2
  exit 1
fi

NODE_VERSION="$(node --version)"

if ! node -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  if (major < 20 || (major === 20 && minor < 19)) {
    process.exit(1);
  }
'; then
  echo "ERROR: Node.js >= 20.19.0 is required. Found ${NODE_VERSION}." >&2
  exit 1
fi

PLUGIN_NAME="Cognium SAST"

PATH_TO_SCAN="${BUILDKITE_PLUGIN_COGNIUM_PATH:-.}"
PACKAGE_VERSION="${BUILDKITE_PLUGIN_COGNIUM_PACKAGE_VERSION:-4.9.16}"
FORMAT="${BUILDKITE_PLUGIN_COGNIUM_FORMAT:-text}"
OUTPUT="${BUILDKITE_PLUGIN_COGNIUM_OUTPUT:-}"
SEVERITY="${BUILDKITE_PLUGIN_COGNIUM_SEVERITY:-}"
CATEGORY="${BUILDKITE_PLUGIN_COGNIUM_CATEGORY:-}"
FAIL_ON_FINDINGS="${BUILDKITE_PLUGIN_COGNIUM_FAIL_ON_FINDINGS:-false}"

echo "--- :shield: ${PLUGIN_NAME}"

echo "Installing cognium-dev@${PACKAGE_VERSION}..."

INSTALL_DIR="$(mktemp -d)"
trap 'rm -rf "$INSTALL_DIR"' EXIT

npm install \
  --prefix "$INSTALL_DIR" \
  --no-save \
  "cognium-dev@${PACKAGE_VERSION}"

COGNIUM_BIN="${INSTALL_DIR}/node_modules/.bin/cognium-dev"

echo "--- :mag: Running Cognium SAST scan"

ARGS=(
  "scan"
  "$PATH_TO_SCAN"
  "--format"
  "$FORMAT"
)

if [[ -n "$OUTPUT" ]]; then
  ARGS+=(
    "--output"
    "$OUTPUT"
  )
fi

if [[ -n "$SEVERITY" ]]; then
  ARGS+=(
    "--severity"
    "$SEVERITY"
  )
fi

if [[ -n "$CATEGORY" ]]; then
  ARGS+=(
    "--category"
    "$CATEGORY"
  )
fi

echo "Path: ${PATH_TO_SCAN}"
echo "Format: ${FORMAT}"

if [[ -n "$OUTPUT" ]]; then
  echo "Output: ${OUTPUT}"
fi

if [[ "$FAIL_ON_FINDINGS" == "true" ]]; then
  echo "Fail on findings: true"
else
  echo "Fail on findings: false"
fi

SCAN_EXIT_CODE=0

"$COGNIUM_BIN" "${ARGS[@]}" || SCAN_EXIT_CODE=$?

echo "--- :mag: Cognium SAST scan exited with code ${SCAN_EXIT_CODE}"

if [[ "$SCAN_EXIT_CODE" -eq 0 ]]; then
  echo "--- :white_check_mark: Cognium SAST scan completed"
  exit 0
fi

if [[ "$SCAN_EXIT_CODE" -eq 1 ]]; then
  if [[ "$FAIL_ON_FINDINGS" == "true" ]]; then
    echo "--- :x: Cognium SAST findings detected; failing because fail-on-findings is true"
    exit 1
  fi

  echo "--- :warning: Cognium SAST findings detected; continuing because fail-on-findings is false"
  exit 0
fi

echo "--- :x: Cognium SAST scanner failed with exit code ${SCAN_EXIT_CODE}"
exit "$SCAN_EXIT_CODE"